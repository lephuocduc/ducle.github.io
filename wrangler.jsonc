{
  "name": "ducle-github-io",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2024-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "wedding-album"
    }
  ]
}
