/**
 * GOOGLE APPS SCRIPT - Thiệp Cưới Phước Đức & Thu Sương
 * API Endpoint để xử lý Lời Chúc (Wishes) & Tải Ảnh Sự Kiện Cưới (Photos / Albums)
 * 
 * HƯỚNG DẪN TRIỂN KHAI:
 * 1. Mở Google Sheet "Wedding Wishes" hiện tại của bạn
 * 2. Sheet 1: "Wishes" (7 cột: id | name | content | createdTime | status | likes | isPinned | visitorId)
 * 3. Sheet 2: "Photos" (Script sẽ TỰ ĐỘNG TẠO nếu chưa có: id | albumId | title | src | driveFileId | driveUrl | createdTime | status)
 * 4. Vào Extensions > Apps Script, dán toàn bộ code mới này vào
 * 5. Deploy > Manage Deployments > Nhấn icon Bút Chì > Chọn Version "New Version" > Deploy
 *    - Execute as: Me (Tài khoản của bạn)
 *    - Who has access: Anyone (Bất kỳ ai)
 * 6. Copy URL triển khai, dán vào weddingConfig.wishesApiUrl trong data/config.js
 */

const SHEET_NAME = "Wishes";
const PHOTOS_SHEET_NAME = "Photos";
const SPREADSHEET_ID = "1Xy4ZNo2TvxFpVZcxoxtt1ysY-ns8E7WT9CjKj3NTuPY"; // Điền Google Sheets ID của bạn
const NOTIFY_OWNER_EMAIL = true; // false nếu muốn tắt thông báo email
const OWNER_EMAIL = "leducst1@gmail.com";
const OWNER_EMAIL_2 = "suongtranst1@gmail.com";
const SHEET_URL = "https://docs.google.com/spreadsheets/d/1Xy4ZNo2TvxFpVZcxoxtt1ysY-ns8E7WT9CjKj3NTuPY/edit#gid=0";

// Mã PIN bảo mật để upload/xóa ảnh (phải trùng với adminPin trong data/config.js)
const ADMIN_PIN = "251026";

// Tùy chọn: ID thư mục Google Drive để lưu ảnh (nếu để trống, script sẽ tự tạo thư mục "Wedding Photos - Duc & Suong")
const DRIVE_FOLDER_ID = "";

function getSpreadsheet() {
    if (SPREADSHEET_ID) {
        return SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);
    }
    return SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
}

// Xử lý GET request - Lấy lời chúc hoặc danh sách ảnh
function doGet(e) {
    const action = e.parameter.action || "getWishes";
    if (action === "getWishes") {
        return handleGetWishes();
    }
    if (action === "getPhotos") {
        return handleGetPhotos();
    }
    return jsonResponse({ success: false, error: "Unknown action" });
}

// Xử lý POST request - Gửi lời chúc, Thả tim, Tải ảnh lên, Xóa ảnh
function doPost(e) {
    const params = e.parameter;
    const action = params.action;
    if (action === "sendWish") return handleSendWish(params);
    if (action === "likeWish") return handleLikeWish(params);
    if (action === "uploadPhoto") return handleUploadPhoto(params);
    if (action === "deletePhoto") return handleDeletePhoto(params);
    return jsonResponse({ success: false, error: "Unknown action" });
}

function handleGetWishes() {
    const sheet = getSpreadsheet();
    if (!sheet) return jsonResponse({ success: false, error: "Sheet not found" });

    const data = sheet.getDataRange().getValues();
    const rows = data.slice(1);

    const wishes = rows
        .filter(row => row[4] === "approved")
        .map(row => ({
            id: row[0],
            name: row[1],
            content: row[2],
            createdTime: row[3],
            status: row[4],
            likes: Number(row[5]) || 0,
            isPinned: row[6] === true || row[6] === "TRUE"
        }));

    return jsonResponse({ success: true, wishes: wishes });
}

function handleSendWish(params) {
    const sheet = getSpreadsheet();
    if (!sheet) return jsonResponse({ success: false, error: "Sheet not found" });

    // Honeypot: neu o an co gia tri -> la bot, gia vo thanh cong nhung khong luu gi ca
    const website = (params.website || "").trim();
    if (website) {
        return jsonResponse({ success: true, id: "hp-" + Date.now() });
    }

    // Lưu dữ liệu nguyên văn - không escape ở đây
    // Client sẽ escape khi render (xem wishes.js hàm escHtml)
    const name = (params.name || "").trim();
    const content = (params.content || "").trim();
    const visitorId = (params.visitorId || "").trim();

    if (!name || !content) return jsonResponse({ success: false, error: "Required fields missing" });
    if (name.length > 60 || content.length > 500) return jsonResponse({ success: false, error: "Input too long" });

    // Kiểm tra rate limit 10 giây cho cùng visitorId
    if (visitorId) {
        const cache = CacheService.getScriptCache();
        const lastSentKey = "rate_limit_" + visitorId;
        const isRateLimited = cache.get(lastSentKey);
        if (isRateLimited) {
            return jsonResponse({
                success: false,
                error: "rate_limit",
                message: "Vui lòng đợi 10 giây trước khi gửi lời chúc tiếp theo!"
            });
        }
        // Lưu vào cache 10 giây
        cache.put(lastSentKey, "1", 10);
    }

    const id = "wish-" + Date.now();
    const now = new Date();
    const vnTime = new Date(now.getTime() + 7 * 60 * 60 * 1000).toISOString().replace("Z", "+07:00");

    // Lưu vào sheet (cột 8: visitorId)
    sheet.appendRow([id, name, content, vnTime, "pending", 0, false, visitorId]);

    // Chi gui email khi loi chuc tu 20 ky tu tro len; ngan hon chi luu sheet
    if (content.length >= 20) {
        notifyNewWish(name, content, vnTime);
    }

    return jsonResponse({ success: true, id: id });
}

function handleLikeWish(params) {
    const sheet = getSpreadsheet();
    if (!sheet) return jsonResponse({ success: false, error: "Sheet not found" });

    const wishId = params.id;
    // Không tin tưởng giá trị likes từ client - server tự tăng +1
    if (!wishId) return jsonResponse({ success: false, error: "Invalid params" });

    // Rate limit: same IP/visitor can only like once per 3 seconds
    const visitorId = params.visitorId || "";
    if (visitorId) {
        const cache = CacheService.getScriptCache();
        const likeRateKey = "like_rate_" + wishId + "_" + visitorId;
        if (cache.get(likeRateKey)) {
            return jsonResponse({ success: false, error: "rate_limited", message: "Vui lòng chờ 3 giây trước khi thả tim tiếp!" });
        }
        cache.put(likeRateKey, "1", 3); // 3 seconds
    }

    const data = sheet.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
        if (data[i][0] === wishId) {
            // Lấy giá trị hiện tại và tăng thêm 1
            const currentLikes = Number(data[i][5]) || 0;
            const newLikes = currentLikes + 1;
            sheet.getRange(i + 1, 6).setValue(newLikes);
            return jsonResponse({ success: true, likes: newLikes });
        }
    }

    return jsonResponse({ success: false, error: "Wish not found" });
}

function jsonResponse(data) {
    return ContentService
        .createTextOutput(JSON.stringify(data))
        .setMimeType(ContentService.MimeType.JSON);
}

function notifyNewWish(name, content, vnTime) {
    if (!NOTIFY_OWNER_EMAIL) return;
    try {
        const subject = "💌 Có lời chúc mới từ " + name;
        const body =
            "Bạn vừa nhận được một lời chúc mới trên thiệp cưới!\n\n" +
            "Người gửi: " + name + "\n" +
            "Nội dung: " + content + "\n" +
            "Thời gian: " + vnTime + "\n\n" +
            "Lưu ý: lời chúc đang ở trạng thái \"pending\" (chờ duyệt) trong Google Sheet.\n" +
            "Vào Sheet, đổi cột status thành \"approved\" để hiển thị công khai trên trang.\n\n" +
            "👉 Mở Google Sheet tại đây: " + SHEET_URL;

        MailApp.sendEmail(OWNER_EMAIL + "," + OWNER_EMAIL_2, subject, body);
    } catch (err) {
        console.error("Gui email that bai: " + err.message);
    }
}

// ==========================================
// XỬ LÝ QUẢN LÝ ẢNH & GOOGLE DRIVE
// ==========================================

function getPhotosSheet() {
    const ss = SPREADSHEET_ID ? SpreadsheetApp.openById(SPREADSHEET_ID) : SpreadsheetApp.getActiveSpreadsheet();
    let sheet = ss.getSheetByName(PHOTOS_SHEET_NAME);
    if (!sheet) {
        sheet = ss.insertSheet(PHOTOS_SHEET_NAME);
        sheet.appendRow(["id", "albumId", "title", "src", "driveFileId", "driveUrl", "createdTime", "status"]);
        sheet.getRange(1, 1, 1, 8).setFontWeight("bold");
    }
    return sheet;
}

function handleGetPhotos() {
    const sheet = getPhotosSheet();
    if (!sheet) return jsonResponse({ success: false, error: "Photos sheet not found" });

    const data = sheet.getDataRange().getValues();
    if (data.length <= 1) {
        return jsonResponse({ success: true, photos: [] });
    }

    const rows = data.slice(1);
    const photos = rows
        .filter(row => row[7] !== "deleted" && row[3])
        .map(row => ({
            id: String(row[0]),
            albumId: String(row[1]),
            title: String(row[2] || ""),
            src: String(row[3]),
            driveFileId: String(row[4] || ""),
            driveUrl: String(row[5] || ""),
            createdTime: String(row[6] || "")
        }));

    return jsonResponse({ success: true, photos: photos });
}

function getUploadFolder() {
    if (DRIVE_FOLDER_ID) {
        return DriveApp.getFolderById(DRIVE_FOLDER_ID);
    }
    const folders = DriveApp.getFoldersByName("Wedding Photos - Duc & Suong");
    if (folders.hasNext()) {
        return folders.next();
    }
    const newFolder = DriveApp.createFolder("Wedding Photos - Duc & Suong");
    newFolder.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    return newFolder;
}

function handleUploadPhoto(params) {
    const pin = (params.pin || "").trim();
    if (pin !== ADMIN_PIN) {
        return jsonResponse({ success: false, error: "invalid_pin", message: "Mã PIN bảo mật không chính xác!" });
    }

    const albumId = (params.albumId || "tiec-truoc-vu-quy").trim();
    const title = (params.title || "").trim();
    const base64Data = params.base64;
    const mimeType = params.mimeType || "image/jpeg";
    const filename = params.filename || ("wedding-photo-" + Date.now() + ".jpg");

    if (!base64Data) {
        return jsonResponse({ success: false, error: "missing_data", message: "Không tìm thấy dữ liệu ảnh!" });
    }

    try {
        const pureBase64 = base64Data.indexOf(",") > -1 ? base64Data.split(",")[1] : base64Data;
        const decoded = Utilities.base64Decode(pureBase64);
        const blob = Utilities.newBlob(decoded, mimeType, filename);

        const folder = getUploadFolder();
        const file = folder.createFile(blob);
        file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

        const fileId = file.getId();
        // Link CDN ảnh Google Drive tốc độ cao hiển thị trên web
        const directUrl = "https://lh3.googleusercontent.com/d/" + fileId;
        const driveUrl = file.getUrl();

        const sheet = getPhotosSheet();
        const id = "photo-" + Date.now() + "-" + Math.floor(Math.random() * 1000);
        const now = new Date();
        const vnTime = new Date(now.getTime() + 7 * 60 * 60 * 1000).toISOString().replace("Z", "+07:00");

        sheet.appendRow([id, albumId, title, directUrl, fileId, driveUrl, vnTime, "active"]);

        return jsonResponse({
            success: true,
            photo: {
                id: id,
                albumId: albumId,
                title: title,
                src: directUrl,
                driveFileId: fileId,
                driveUrl: driveUrl,
                createdTime: vnTime
            }
        });
    } catch (err) {
        return jsonResponse({ success: false, error: err.message });
    }
}

function handleDeletePhoto(params) {
    const pin = (params.pin || "").trim();
    if (pin !== ADMIN_PIN) {
        return jsonResponse({ success: false, error: "invalid_pin", message: "Mã PIN bảo mật không chính xác!" });
    }

    const photoId = params.id;
    if (!photoId) return jsonResponse({ success: false, error: "Missing photo id" });

    const sheet = getPhotosSheet();
    const data = sheet.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
        if (data[i][0] === photoId) {
            sheet.getRange(i + 1, 8).setValue("deleted");
            const fileId = data[i][4];
            if (fileId) {
                try {
                    DriveApp.getFileById(fileId).setTrashed(true);
                } catch (e) {}
            }
            return jsonResponse({ success: true, id: photoId });
        }
    }

    return jsonResponse({ success: false, error: "Photo not found" });
}